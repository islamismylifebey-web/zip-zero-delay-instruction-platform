# Cloudflare backend only. Never commit real secret values.
OPENAI_API_KEY=

# Public frontend/backend routing.
NEXT_PUBLIC_ZIP_API_ORIGIN=
ZIP_FRONTEND_ORIGINS=

# Cloudflare Access application identity. These identify the Access application;
# the JWT itself is supplied per request and verified server-side.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=

# Deployment-time Cloudflare resource identifiers. Keep actual values outside Git.
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_DATABASE_NAME=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_WORKER_NAME=zip-zero-delay-backend
